# src/game.py
import random
import time

class Game:
    def __init__(self, party):
        self.party = party
        self.turn = 1
        self.max_turns = 30
        self.event_manager = None  # Will be initialized in start()
        self.game_over = False
        self.locations = [
            "Winterfell", "King's Landing", "The Wall", "Riverrun",
            "Casterly Rock", "The Eyrie", "Dragonstone", "Highgarden",
            "Dorne", "The Iron Islands", "Braavos"
        ]
        
    def start(self):
        """Start the game loop."""
        from src.events import EventManager
        self.event_manager = EventManager()
        
        while not self.game_over and self.turn <= self.max_turns:
            self._process_turn()
            
            # Check if party is still alive
            if not self.party.is_alive():
                self._end_game("Your entire party has perished. Winter has come for you.")
                break
                
            # Check if max turns reached
            if self.turn > self.max_turns:
                self._end_game("You have survived to see the coming of spring.")
                break
                
            # Ask player to continue
            choice = input("\nContinue to next turn? (y/n): ").lower()
            if choice != 'y':
                self._end_game("You have chosen to end your journey.")
                break
                
            self.turn += 1
            
    def _process_turn(self):
        """Process a single game turn."""
        self._display_turn_info()
        
        # Resource consumption
        self._consume_resources()
        
        # Travel option
        self._travel_option()
        
        # Random event
        self._random_event()
        
        # End of turn status
        self.party.display_status()
        
    def _display_turn_info(self):
        """Display information at the start of a turn."""
        print("\n" + "=" * 50)
        print(f"TURN {self.turn} | Location: {self.party.location}")
        print("=" * 50)
        
        # Winter progress
        winter_progress = min(100, (self.turn / self.max_turns) * 100)
        print(f"Winter is {winter_progress:.1f}% here...")
        
        # Show abbreviated party status
        print(f"Party: {len([m for m in self.party.members if m.is_alive()])}/{len(self.party.members)} members alive")
        print(f"Resources: Gold {self.party.resources['gold']}, Food {self.party.resources['food']}, Medicine {self.party.resources['medicine']}")
        print("=" * 50 + "\n")
        
    def _consume_resources(self):
        """Consume resources for the turn."""
        food_needed = len(self.party.members) // 2 + 1
        
        print(f"Your party requires {food_needed} food for this turn.")
        
        if self.party.resources['food'] >= food_needed:
            self.party.resources['food'] -= food_needed
            print("Your party eats well.")
        else:
            print("You don't have enough food! Party members take damage from hunger.")
            for member in self.party.members:
                if member.is_alive():
                    member.take_damage(1)
                    print(f"{member.name} takes 1 damage from hunger.")
        
    def _travel_option(self):
        """Give the player an option to travel to a new location."""
        print("\nWould you like to travel to a new location?")
        choice = input("(y/n): ").lower()
        
        if choice == 'y':
            # Generate 3 random destinations (excluding current location)
            possible_destinations = [loc for loc in self.locations if loc != self.party.location]
            destinations = random.sample(possible_destinations, min(3, len(possible_destinations)))
            
            print("\nChoose a destination:")
            for i, destination in enumerate(destinations, 1):
                print(f"{i}. {destination}")
                
            try:
                travel_choice = int(input("Enter your choice (or 0 to stay): "))
                if 1 <= travel_choice <= len(destinations):
                    new_location = destinations[travel_choice - 1]
                    print(f"\nTraveling to {new_location}...")
                    
                    # Travel event (chance of ambush or delay)
                    if random.random() < 0.3:
                        print("Your journey is interrupted!")
                        danger_event = self.event_manager.get_random_event()
                        danger_event.execute(self.party)
                    
                    # Complete travel
                    self.party.location = new_location
                    print(f"You have arrived at {new_location}.")
                else:
                    print("\nDeciding to stay at your current location.")
            except ValueError:
                print("\nInvalid choice. Staying at current location.")
        else:
            print("\nYou decide to stay at your current location.")
            
    def _random_event(self):
        """Generate and execute a random event for this turn."""
        print("\nAn event occurs...")
        time.sleep(1)
        
        event = self.event_manager.get_random_event()
        event.execute(self.party)
        
    def _end_game(self, message):
        """End the game with the given message."""
        print("\n" + "=" * 50)
        print("GAME OVER")
        print("=" * 50)
        print(message)
        
        # Calculate final score
        score = self._calculate_score()
        
        print("\nFinal Score:", score)
        
        # Display achievements
        self._display_achievements()
        
        self.game_over = True
        
    def _calculate_score(self):
        """Calculate the final score based on various factors."""
        score = 0
        
        # Surviving members
        surviving_members = len([m for m in self.party.members if m.is_alive()])
        score += surviving_members * 100
        
        # Resources left
        score += self.party.resources["gold"] // 10
        score += self.party.resources["food"] * 5
        score += self.party.resources["medicine"] * 20
        
        # Reputation bonus
        for region, value in self.party.reputation.items():
            if value > 20:
                score += 50
            elif value > 50:
                score += 100
                
        # Turns survived
        score += self.turn * 10
        
        return score
        
    def _display_achievements(self):
        """Display special achievements earned during the game."""
        achievements = []
        
        # Check for various achievements
        if len(self.party.members) >= 5:
            achievements.append("The Gatherer - Recruited a large party")
            
        if self.party.resources["gold"] > 300:
            achievements.append("Master of Coin - Accumulated significant wealth")
            
        if all(value > 0 for value in self.party.reputation.values()):
            achievements.append("The Diplomat - Maintained positive relations with all regions")
            
        if self.turn >= self.max_turns:
            achievements.append("Winter's Bane - Survived until spring")
            
        # Display achievements
        if achievements:
            print("\nAchievements Earned:")
            for achievement in achievements:
                print(f"  - {achievement}")
        else:
            print("\nNo special achievements earned this game.")
